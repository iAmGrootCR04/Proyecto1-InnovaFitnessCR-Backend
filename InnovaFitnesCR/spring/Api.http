  "descripcion": "Ejercicio de piernas",
  "imagenUrl": "https://example.com/sentadilla.jpg",
  "categoria": "hoka"
}

### Actualizar
PUT {{host}}/ejercicios/2
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "nombre": "Sentadilla",
  "descripcion": "Ejercicio de piernas",
    "imagenUrl": "https://example.com/sentadilla.jpg",
  "categoria": "hola"
}

### Eliminar
DELETE {{host}}/ejercicios/1
Authorization: Bearer {{token}}


### Obtener todas las relaciones RutinaEjercicio
GET {{host}}/rutina-ejercicios
Authorization: Bearer {{token}}

### Obtener una relación por ID
GET {{host}}/rutina-ejercicios/1
Authorization: Bearer {{token}}

### Crear una nueva relación Rutina ↔ Ejercicio
POST {{host}}/rutina-ejercicios
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "ordenEjercicio": 1,
  "series": 4,
  "repeticiones": 12,
  "descanso": "90s",
  "rutina": { "id": 1 },
  "ejercicio": { "id": 2 }
}

### Actualizar una relación existente
PUT {{host}}/rutina-ejercicios/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "ordenEjercicio": 2,
  "series": 3,
  "repeticiones": 10,
  "descanso": "60s",
  "rutina": { "id": 1 },
  "ejercicio": { "id": 2 }
}

### Eliminar una relación por ID
DELETE {{host}}/rutina-ejercicios/1
Authorization: Bearer {{token}}

